# Runtime credential: grant the built-in read role on the InternShield database only.
MONGODB_URI=

# Seeding credential: grant readWrite on that database only; used by `npm run seed`, not the app.
MONGODB_SEED_URI=

MONGODB_DB_NAME=internshield
NODE_ENV=development
PORT=3000

# Number of trusted reverse-proxy hops in front of Express. Keep 0 when directly exposed.
# Configure the exact number for your host before relying on IP-based rate limiting.
TRUST_PROXY_HOPS=0
